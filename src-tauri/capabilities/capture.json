{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "Capture overlay windows (control bar + panels): relay events, drag-to-move.",
  "windows": ["cap-bar", "cap-answers", "cap-transcript", "cap-controls"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size"
  ]
}
